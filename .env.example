# Backend API URL — override at runtime with -e NUXT_PUBLIC_API_BASE=...
NUXT_PUBLIC_API_BASE=http://localhost:8081

# WebSocket base URL — leave unset to derive automatically from NUXT_PUBLIC_API_BASE (http→ws)
# NUXT_PUBLIC_WS_BASE=ws://localhost:8081

# Laravel Reverb WebSocket — copy REVERB_APP_KEY from matches-api-laravel/.env
NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http
